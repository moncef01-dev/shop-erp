# ─── Fournisseur de base de données ──────────────────────────────────────────
# Valeurs : "sqlite" (défaut) ou "postgres"
# Le client, les migrations CLI et les sauvegardes suivent automatiquement
# cette valeur. Redémarrer le serveur (`npm run dev`) après modification.
DB_PROVIDER=sqlite

# ─── SQLite (utilisé si DB_PROVIDER=sqlite) ──────────────────────────────────
# Le fichier est créé à prisma/shop.db (chemins relatifs résolus depuis la racine).
DATABASE_URL="file:./prisma/shop.db"

# ─── PostgreSQL (requis si DB_PROVIDER=postgres) ─────────────────────────────
POSTGRES_DATABASE_URL=postgresql://user:password@localhost:5432/shop
